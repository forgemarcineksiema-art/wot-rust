MapBlueprint(
    meta: MetaSpec(
        version: 1,
        id: "orliny_pereval",
        name: "Orliny Pereval",
        historical_basis: "Caucasus foothills, August-October 1942: the fight for the high passes during Operation Edelweiss (Klukhor, Marukh, Sancharo) - a fictional pass composed for mirror fairness; no specific engagement is depicted.",
        design_notes: [
            "an east-west mountain wall sits ON the mirror axis and is impassable except at three gates - the wide Dolina meadow col (west), the high pass carrying the hamlet of Orlinoye (center), and the rocky defile (east); the three gates ARE the three lanes",
            "the two summits (Sokol west, Oryol east) stand on the axis, contested equally, but are reachable ONLY through the pass col - taking the middle unlocks the high ground, and the high ground dominates both flanks",
            "1000m x 1000m at 5m height samples, mirror-symmetric across the axis; DRY map by design - a single global water level cannot perch a mountain tarn, and the highland reads honest without one",
        ],
    ),
    grid: GridSpec(
        size_m: (1000.0, 1000.0),
        cell_m: 5.0,
        min_height_m: 0.2,
    ),
    symmetry: Some(MirrorZ),
    // Immersja A3.1: a mountain PASS was ringed by 60 m mounds — the range rises to
    // 130 m so the peaks finally look down on the crests the map fights over.
    horizon: Some(HorizonSpec(
        hills_base_m: 130.0,
        swell: (24.0, 0.006, 0.005, 2.3),
        x_roll: (13.0, 0.01),
        z_roll: (10.0, 0.009),
        closure_start_m: 20.0,
        closure_span_m: 260.0,
        river_gap_half_m: 0.0,
        river_gap_falloff_m: 1.0,
    )),
    terrain: TerrainProgram(
        base: SlopeEases(
            base: 13.0,
            eases: [
                (140.0, 180.0, -4.0),
                (560.0, 240.0, 6.0),
                (880.0, 100.0, 7.0),
            ],
        ),
        ops: [
            Relief(
                terms: [SinX(amp: 1.1, wave: 90.0), CosDz(amp: 0.9, wave: 75.0), SinXCosDz(amp: 0.6, x_freq: 0.05, dz_freq: 0.033)],
                dampen: [TownRect(rect: RectBand(x_center_m: 500.0, x_half_m: 70.0, x_falloff_m: 40.0, dz_half_m: 55.0, dz_falloff_m: 35.0), strength: 0.8)],
            ),
            Gauss1(
                axis: Z,
                apply: Add,
                terms: [Gauss1Term(center: 500.0, sigma: 150.0, amp: 10.0)],
            ),
            RidgeGated(
                center: 500.0,
                sigma: 30.0,
                amp: 34.0,
                gates: [Gauss1Term(center: 200.0, sigma: 48.0, amp: 1.0), Gauss1Term(center: 500.0, sigma: 58.0, amp: 1.0), Gauss1Term(center: 840.0, sigma: 26.0, amp: 1.0)],
            ),
            Gauss2(
                apply: Add,
                terms: [Gauss2Term(x: 340.0, z: 500.0, sx: 85.0, sz: 70.0, amp: 16.0), Gauss2Term(x: 680.0, z: 500.0, sx: 90.0, sz: 70.0, amp: 16.0)],
            ),
            Gauss2(
                apply: Add,
                terms: [Gauss2Term(x: 500.0, z: 500.0, sx: 60.0, sz: 45.0, amp: 6.0)],
            ),
            CrestShelf(
                crest_x: 285.0,
                shelf_x: 310.0,
                sigma_x: 9.0,
                crest_h: 2.0,
                shelf_cut: 1.3,
                windows: [(325.0, 65.0), (675.0, 65.0)],
            ),
            CrestShelf(
                crest_x: 585.0,
                shelf_x: 610.0,
                sigma_x: 10.0,
                crest_h: 2.2,
                shelf_cut: 1.4,
                windows: [(330.0, 70.0), (670.0, 70.0)],
            ),
            Gauss2(
                apply: Add,
                terms: [Gauss2Term(x: 90.0, z: 210.0, sx: 32.0, sz: 40.0, amp: 5.0), Gauss2Term(x: 90.0, z: 790.0, sx: 32.0, sz: 40.0, amp: 5.0), Gauss2Term(x: 930.0, z: 220.0, sx: 35.0, sz: 45.0, amp: 6.0), Gauss2Term(x: 930.0, z: 780.0, sx: 35.0, sz: 45.0, amp: 6.0)],
            ),
            // Rocky knuckles over the defile: tight bumps stacked on the wall flanks push the
            // combined slope past the splat's rock break, so the slot reads as the stone gate
            // it plays as. Mirrored pairs; the slot centre (x 840) stays untouched.
            Gauss2(
                apply: Add,
                terms: [Gauss2Term(x: 792.0, z: 470.0, sx: 16.0, sz: 14.0, amp: 10.0), Gauss2Term(x: 792.0, z: 530.0, sx: 16.0, sz: 14.0, amp: 10.0), Gauss2Term(x: 888.0, z: 468.0, sx: 15.0, sz: 14.0, amp: 10.0), Gauss2Term(x: 888.0, z: 532.0, sx: 15.0, sz: 14.0, amp: 10.0)],
            ),
            FlattenToGauss(
                target_m: 31.0,
                x: 500.0,
                z: 500.0,
                sx: 45.0,
                sz: 45.0,
            ),
            ClampMin(0.2),
        ],
    ),
    materials: Some(GroundMaterialsSpec(
        // Alpine palette: cool meadow greens, sun-cured high grass, and grey granite where
        // the slope breaks the turf.
        layers: (
            GroundLayerSpec(albedo: (0.24, 0.32, 0.22), detail: 1.0, gloss: 0.03),
            GroundLayerSpec(albedo: (0.44, 0.4, 0.27), detail: 1.0, gloss: 0.03),
            GroundLayerSpec(albedo: (0.31, 0.27, 0.21), detail: 0.8, gloss: 0.05),
            GroundLayerSpec(albedo: (0.47, 0.47, 0.44), detail: 1.0, gloss: 0.13),
        ),
        macro_normal_strength: 0.8,
        // No worked plots this high up - the meadows patch faintly, if at all.
        field_patch_strength: 0.55,
    )),
    environment: Some(EnvironmentSpec(
