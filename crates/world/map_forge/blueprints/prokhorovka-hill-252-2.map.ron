MapBlueprint(
    meta: MetaSpec(
        version: 1,
        id: "prokhorovka_hill_252_2",
        name: "Prokhorovka - Hill 252.2 Sector",
        historical_basis: "Prokhorovka, 12 July 1943: Hill 252.2, Oktyabrskiy State Farm, the Psel corridor, anti-tank ditch, and railway embankment.",
        design_notes: [
            "open steppe tank map, rebuilt on its historical skeleton: the east-west railway embankment divides the sectors, the naked Psel flank runs west, Hill 252.2 rules the east - and the steppe is now CUT the way the real one is, by drawn balkas",
            "three lanes, three characters: the bare Psel field (fast and punished), the Oktyabrskiy farm corridor on its bench (the brawl), and the hill duel with TWO hull-down systems per side - the west-facing crest shelf against pushes from the centre, and the axis-facing top ridge for the north-south standoff",
            "the anti-tank ditch is a meandering balka ~110 m before the axis: the covered east-west rotation of each half - masked from the embankment line, still overlooked from the hill top; the Storozhevoe draw gives a masked approach into the east lane",
            "1000m x 1000m at 5m height samples; mirror-symmetric across the central embankment axis so both teams get equivalent ground",
        ],
    ),
    grid: GridSpec(
        size_m: (1000.0, 1000.0),
        cell_m: 5.0,
        min_height_m: 0.2,
    ),
    symmetry: Some(MirrorZ),
    river: None,
    terrain: TerrainProgram(
        base: Constant(8.0),
        ops: [
            Relief(
                terms: [SinX(amp: 1.3, wave: 85.0), CosDz(amp: 1.0, wave: 70.0), SinXCosDz(amp: 0.6, x_freq: 0.055, dz_freq: 0.035)],
                dampen: [LinearRampX(inner_m: 160.0, outer_m: 320.0, strength: 0.92)],
            ),
            RidgeGated(
                center: 500.0,
                sigma: 7.0,
                amp: 9.0,
                gates: [Gauss1Term(center: 250.0, sigma: 13.0, amp: 1.0), Gauss1Term(center: 500.0, sigma: 13.0, amp: 1.0), Gauss1Term(center: 750.0, sigma: 13.0, amp: 1.0)],
            ),
            Gauss2(
                apply: Add,
                terms: [Gauss2Term(x: 800.0, z: 350.0, sx: 150.0, sz: 95.0, amp: 22.0), Gauss2Term(x: 800.0, z: 650.0, sx: 150.0, sz: 95.0, amp: 22.0)],
            ),
            CrestShelf(
                crest_x: 726.0,
                shelf_x: 752.0,
                sigma_x: 11.0,
                crest_h: 2.5,
                shelf_cut: 1.6,
                windows: [(350.0, 78.0), (650.0, 78.0)],
            ),
            // The axis-facing hull-down line on the hill top (drawn ridge, mirrored pair):
            // covers the north-south standoff over the saddle the way the crest shelf
            // covers pushes from the centre - the second hull-down system per side.
            Stroke(StrokeSpec(
                points: [(700.0, 370.0), (780.0, 368.0), (860.0, 370.0)],
                profile: Ridge(amp_m: 3.0),
                half_width_m: 5.0,
                falloff_m: 9.0,
            )),
            Stroke(StrokeSpec(
                points: [(700.0, 630.0), (780.0, 632.0), (860.0, 630.0)],
                profile: Ridge(amp_m: 3.0),
                half_width_m: 5.0,
                falloff_m: 9.0,
            )),
            Gauss2(
                apply: Add,
                terms: [Gauss2Term(x: 235.0, z: 200.0, sx: 40.0, sz: 55.0, amp: 6.0), Gauss2Term(x: 235.0, z: 800.0, sx: 40.0, sz: 55.0, amp: 6.0)],
            ),
            // The anti-tank ditch, redrawn as a balka: a meandering trench ~110 m before
            // the axis - the covered east-west rotation of each half. Fully masked from
            // the embankment line, NOT from the hill top; edge grade ~0.48, crossable
            // everywhere (the bots' no-wall promise).
            Stroke(StrokeSpec(
                points: [(330.0, 392.0), (420.0, 380.0), (520.0, 384.0), (610.0, 396.0), (700.0, 414.0)],
                profile: Valley(depth_m: 3.5),
                half_width_m: 7.0,
                falloff_m: 11.0,
            )),
            Stroke(StrokeSpec(
                points: [(330.0, 608.0), (420.0, 620.0), (520.0, 616.0), (610.0, 604.0), (700.0, 586.0)],
                profile: Valley(depth_m: 3.5),
                half_width_m: 7.0,
                falloff_m: 11.0,
            )),
            // The Storozhevoe draw: a diagonal balka from the spawn's east shoulder to the
            // hill foot - the masked approach into the east lane. Its mouth stops short of
            // the shelf so the hull-down line stays clean.
            Stroke(StrokeSpec(
                points: [(602.0, 168.0), (668.0, 214.0), (726.0, 262.0), (752.0, 292.0)],
                profile: Valley(depth_m: 3.0),
                half_width_m: 6.0,
                falloff_m: 10.0,
            )),
            Stroke(StrokeSpec(
                points: [(602.0, 832.0), (668.0, 786.0), (726.0, 738.0), (752.0, 708.0)],
                profile: Valley(depth_m: 3.0),
                half_width_m: 6.0,
                falloff_m: 10.0,
            )),
            // The farm bench: the "farm rise" its Observation point always claimed, now
            // real ground - drawn benches seat the yard at 11 m. Late in the program, after
            // all additive shaping.
            Stroke(StrokeSpec(
                points: [(452.0, 469.0), (548.0, 469.0)],
                profile: Plateau(target_m: 11.0),
                half_width_m: 14.0,
                falloff_m: 10.0,
            )),
            Stroke(StrokeSpec(
                points: [(452.0, 531.0), (548.0, 531.0)],
                profile: Plateau(target_m: 11.0),
                half_width_m: 14.0,
                falloff_m: 10.0,
            )),
            Gauss1(
                axis: X,
                apply: Subtract,
                terms: [Gauss1Term(center: 0.0, sigma: 140.0, amp: 4.0)],
            ),
            ClampMin(0.2),
        ],
    ),
    water: None,
    materials: Some(GroundMaterialsSpec(
        // Grey-green grass drifting to sun-dried straw, dirt roads, and the chalk that
