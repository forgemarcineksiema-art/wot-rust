MapBlueprint(
    meta: MetaSpec(
        version: 1,
        id: "ostrogorsk",
        name: "Ostrogorsk",
        historical_basis: "Voronezh axis, late summer 1943: a small railway city behind the Ostrogozhsk-Rossosh line - a fictional city composed for mirror fairness; no specific engagement is depicted.",
        design_notes: [
            "city + open outskirts hybrid: a dense masonry city on the west bench, open field patchwork and a north-south rail embankment on the east, the boulevard square between them - every playstyle gets its flank",
            "the berm is the east wall: 7 m of fill exceeding the climb grade everywhere except three gates (the level crossing on the axis, two mirrored underpass cuts) - the eastern routes ARE the gates",
            "DENSE CORE stage (urban-map program PR-12): 48-block CityBuilding tenement grid in cobbled street canyons, mirrored factory compounds behind breachable StoneWall yards, born-ruin pairs opening cross-block sightlines, garden walls screening the boulevard seam - outskirts polish follows in PR-13",
        ],
    ),
    grid: GridSpec(
        size_m: (1000.0, 1000.0),
        cell_m: 5.0,
        min_height_m: 0.2,
    ),
    symmetry: Some(MirrorZ),
    horizon: Some(HorizonSpec(
        hills_base_m: 24.0,
        swell: (5.5, 0.008, 0.006, 1.8),
        x_roll: (3.5, 0.012),
        z_roll: (3.0, 0.01),
        closure_start_m: 30.0,
        closure_span_m: 280.0,
        river_gap_half_m: 0.0,
        river_gap_falloff_m: 1.0,
    )),
    terrain: TerrainProgram(
        base: SlopeEases(
            base: 14.0,
            eases: [
                (470.0, 140.0, -3.0),
                (700.0, 180.0, -3.0),
            ],
        ),
        ops: [
            Relief(
                terms: [SinX(amp: 0.8, wave: 80.0), CosDz(amp: 0.7, wave: 65.0), SinXCosDz(amp: 0.5, x_freq: 0.045, dz_freq: 0.032)],
                dampen: [TownRect(rect: RectBand(x_center_m: 255.0, x_half_m: 215.0, x_falloff_m: 45.0, dz_half_m: 330.0, dz_falloff_m: 45.0), strength: 0.85)],
            ),
            // The city bench: one honest grade under every street, falling gently from the
            // west edge toward the boulevard so the town drains east without a single step.
            FlattenToRamp(
                mask: RectBand(x_center_m: 255.0, x_half_m: 215.0, x_falloff_m: 45.0, dz_half_m: 330.0, dz_falloff_m: 45.0),
                ramp_base_m: 14.2,
                ramp_from_x_m: 40.0,
                ramp_slope: -0.005,
                strength: 0.9,
            ),
            // Mirrored outskirts rises between the boulevard and the berm: the open-flank
            // high ground, with a sculpted hull-down line on their west shoulders.
            Gauss2(
                apply: Add,
                terms: [Gauss2Term(x: 680.0, z: 330.0, sx: 60.0, sz: 50.0, amp: 6.0), Gauss2Term(x: 680.0, z: 670.0, sx: 60.0, sz: 50.0, amp: 6.0)],
            ),
            CrestShelf(
                crest_x: 615.0,
                shelf_x: 640.0,
                sigma_x: 9.0,
                crest_h: 1.8,
                shelf_cut: 1.2,
                windows: [(330.0, 60.0), (670.0, 60.0)],
            ),
            // The mainline embankment: a north-south fill at x 830 whose 5 m-step grade
            // exceeds the 0.55 climb wall - impassable by design except at the gates.
            Gauss1(
                axis: X,
                apply: Add,
                terms: [Gauss1Term(center: 830.0, sigma: 6.0, amp: 7.0)],
            ),
            // The three gates: the level crossing on the axis and two mirrored underpass
            // cuts. Wider gaussians than the berm, so each gate reads as a real cutting
            // with sunken approaches instead of a knife slot.
            Gauss2(
                apply: Subtract,
                terms: [Gauss2Term(x: 830.0, z: 500.0, sx: 12.0, sz: 14.0, amp: 7.0), Gauss2Term(x: 830.0, z: 270.0, sx: 12.0, sz: 10.0, amp: 7.0), Gauss2Term(x: 830.0, z: 730.0, sx: 12.0, sz: 10.0, amp: 7.0)],
            ),
            ClampMin(0.2),
        ],
    ),
    materials: Some(GroundMaterialsSpec(
        // Dusty late-summer city palette: worn green verges, sun-cured stubble, packed
        // earth lanes, and grey rubble-stone where the grades break.
        layers: (
            GroundLayerSpec(albedo: (0.3, 0.33, 0.24), detail: 1.0, gloss: 0.03),
            GroundLayerSpec(albedo: (0.45, 0.41, 0.28), detail: 1.0, gloss: 0.03),
            GroundLayerSpec(albedo: (0.33, 0.29, 0.23), detail: 0.85, gloss: 0.05),
            GroundLayerSpec(albedo: (0.46, 0.46, 0.44), detail: 1.0, gloss: 0.12),
        ),
        macro_normal_strength: 0.7,
        // The east flank is worked farmland right up to the berm - the patchwork reads.
        field_patch_strength: 0.85,
    )),
    environment: Some(EnvironmentSpec(
        // First look = the default and the fallback; list order feeds the seeded roll.
        looks: [
            LookSpec(
                variant: ClearAfternoon,
                preset: HazyNoon,
                sky_rgb: (0.62, 0.66, 0.72),
            ),
            LookSpec(
                variant: GoldenEvening,
                preset: GoldenEvening,
                sky_rgb: (0.82, 0.6, 0.42),
            ),
            LookSpec(
                variant: Overcast,
                preset: LeadOvercast,
                sky_rgb: (0.46, 0.49, 0.53),
            ),
            LookSpec(
                variant: RainSqualls,
                preset: RainSqualls,
                sky_rgb: (0.42, 0.46, 0.5),
                rain_intensity: 1.0,
                wetness: 1.0,
            ),
        ],
    )),
    objects: [
        // The church on the mirror axis: the tall silhouette of the square, contested
