    // Teren C3: the valley's FIRST roads — the default battle map fought roadless for a
    // month. Dirt lanes tie the spawns to every crossing; Kamienna's street and the bridge
    // road are granite setts (the stone town the church and mill always claimed), which
    // since teren A2 also DRIVE as stone — the fast rotation is the paved one.
    roads: [
        MirroredPair(
            id_base: "valley_road",
            surface: Dirt,
            south_points: [(400.0, 150.0), (430.0, 260.0), (450.0, 380.0), (470.0, 460.0)],
            width_m: 7.0,
        ),
        Road(
            id: "bridge_street",
            surface: Cobble,
            points: [(470.0, 500.0), (700.0, 500.0)],
            width_m: 6.0,
        ),
        Road(
            id: "town_street",
            surface: Cobble,
            points: [(700.0, 380.0), (706.0, 440.0), (706.0, 560.0), (700.0, 620.0)],
            width_m: 5.5,
        ),
        // The crossing tracks are QUARRY GRAVEL (Ballast): Kamienna's quarry is right up
        // the hill, and a ford road through a floodplain is exactly what crushed stone is
        // for. Since teren A2 that also means they DRIVE as stone — the fast, honest lane
        // through the mud belt the second terrace widened.
        MirroredPair(
            id_base: "ford_track",
            surface: Ballast,
            south_points: [(450.0, 380.0), (505.0, 340.0), (560.0, 320.0), (620.0, 330.0), (650.0, 350.0)],
            width_m: 5.0,
        ),
        MirroredPair(
            id_base: "plank_track",
            surface: Ballast,
            south_points: [(430.0, 260.0), (480.0, 220.0), (530.0, 185.0), (575.0, 180.0), (620.0, 200.0), (640.0, 240.0)],
            width_m: 4.5,
        ),
    ],
