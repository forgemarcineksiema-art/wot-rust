MapBlueprint(
    meta: MetaSpec(
        version: 1,
        id: "bystra_valley",
        name: "Dolina Bystrej",
        historical_basis: "Fictional: a Central-European river valley composed for balanced crossing combat — no historical engagement is depicted.",
        design_notes: [
            "the Bystra river runs along the axis of advance, splitting the map into an open farmland flank (west, the long-range game) and the town of Kamienna on the eastern slope (the brawl); five crossings decide the mid-game rotations",
            "1000m x 1000m at 5m height samples; mirror-symmetric across the central axis so both teams get equivalent ground, crossings, and town blocks",
            "the channel is carved to an explicit bed target: drowning-deep everywhere except the two ford sills, with the causeway and plank decks raised above the water line",
        ],
    ),
    grid: GridSpec(
        size_m: (1000.0, 1000.0),
        cell_m: 5.0,
        min_height_m: 0.2,
    ),
    symmetry: Some(MirrorZ),
    river: Some(RiverSpec(
        base_x_m: 585.0,
        axis_z_m: 500.0,
        bow_sigma_m: 200.0,
        bow_amp_m: 45.0,
        wiggle_amp_m: 14.0,
        wiggle_wave_m: 70.0,
        corridor_half_width_m: 31.0,
    )),
    // Immersja A3.1: the valley's enclosure rises from a berm (27 m) to real hills — a
    // river valley is CARVED, and the eye must read the mass it was carved from.
    horizon: Some(HorizonSpec(
        hills_base_m: 65.0,
        swell: (13.0, 0.0085, 0.006, 1.7),
        x_roll: (8.0, 0.013),
        z_roll: (6.0, 0.011),
        closure_start_m: 30.0,
        closure_span_m: 280.0,
        river_gap_half_m: 34.0,
        river_gap_falloff_m: 40.0,
    )),
    terrain: TerrainProgram(
        base: SlopeEases(
            base: 12.5,
            eases: [
                (180.0, 250.0, -5.5),
                (640.0, 200.0, 8.0),
                (860.0, 90.0, 9.0),
            ],
        ),
        ops: [
            Relief(
                terms: [SinX(amp: 0.9, wave: 70.0), CosDz(amp: 0.7, wave: 60.0), SinXCosDz(amp: 0.5, x_freq: 0.043, dz_freq: 0.031)],
                dampen: [TownRect(rect: RectBand(x_center_m: 745.0, x_half_m: 95.0, x_falloff_m: 45.0, dz_half_m: 165.0, dz_falloff_m: 45.0), strength: 0.85), RiverBand(half_width_m: 31.0, falloff_m: 20.0, strength: 0.9)],
            ),
            Gauss2(
                apply: Add,
                terms: [Gauss2Term(x: 250.0, z: 500.0, sx: 90.0, sz: 120.0, amp: 11.0)],
            ),
            CrestShelf(
                crest_x: 365.0,
                shelf_x: 340.0,
                sigma_x: 9.0,
                crest_h: 1.4,
                shelf_cut: 1.0,
                windows: [(410.0, 60.0), (590.0, 60.0)],
            ),
            Gauss2(
                apply: Add,
                terms: [Gauss2Term(x: 105.0, z: 200.0, sx: 35.0, sz: 45.0, amp: 5.0), Gauss2Term(x: 105.0, z: 800.0, sx: 35.0, sz: 45.0, amp: 5.0)],
            ),
            FlattenToRamp(
                mask: RectBand(x_center_m: 745.0, x_half_m: 95.0, x_falloff_m: 45.0, dz_half_m: 165.0, dz_falloff_m: 45.0),
                ramp_base_m: 8.0,
                ramp_from_x_m: 650.0,
                ramp_slope: 0.037,
                strength: 0.85,
            ),
            FlattenToGauss(
                target_m: 17.5,
                x: 935.0,
                z: 500.0,
                sx: 45.0,
                sz: 60.0,
            ),
            RiverBandAdd(
                half_width_m: 30.0,
                falloff_m: 45.0,
                delta_m: -1.0,
            ),
            // Teren C3: the SECOND floodplain terrace - the valley used to drop one metre
            // over sixty and read as a hard bank; a wider, gentler step gives the river a
            // real lowland, and the structural moisture (teren A1) wets it into meadow.
            RiverBandAdd(
                half_width_m: 42.0,
                falloff_m: 40.0,
                delta_m: -0.3,
            ),
            CarveChannel(
                half_width_m: 13.0,
                falloff_m: 12.0,
                water_level_m: 5.0,
                channel_depth_m: 2.6,
                sill_depth_m: 0.65,
                sills: [(320.0, 26.0), (680.0, 26.0)],
            ),
            Deck(
                dz_m: 0.0,
                deck_m: 6.4,
                half_width_m: 7.0,
                half_length_m: 34.0,
                width_falloff_m: 6.0,
                length_falloff_m: 14.0,
            ),
            Deck(
                dz_m: -320.0,
                deck_m: 5.6,
                half_width_m: 4.5,
                half_length_m: 26.0,
                width_falloff_m: 6.0,
                length_falloff_m: 14.0,
            ),
            Deck(
                dz_m: 320.0,
                deck_m: 5.6,
                half_width_m: 4.5,
                half_length_m: 26.0,
                width_falloff_m: 6.0,
                length_falloff_m: 14.0,
            ),
            // Teren C3, sesja sculpt: meadow swales draining the west slope into the
            // floodplain (mirrored - the moisture rule wets them on its own), and a low
            // bluff pair just west of the town bench: the east bank's hull-down looking
            // at the bridge, tank-scale relief where the crossing fight actually happens.
            Stroke(StrokeSpec(
                points: [(280.0, 260.0), (330.0, 295.0), (380.0, 325.0)],
                profile: Valley(depth_m: 0.7),
                half_width_m: 5.0,
                falloff_m: 9.0,
            )),
            Stroke(StrokeSpec(
                points: [(280.0, 740.0), (330.0, 705.0), (380.0, 675.0)],
                profile: Valley(depth_m: 0.7),
                half_width_m: 5.0,
                falloff_m: 9.0,
            )),
            Stroke(StrokeSpec(
                points: [(612.0, 402.0), (632.0, 430.0), (644.0, 462.0), (648.0, 484.0)],
                profile: Ridge(amp_m: 1.6),
                half_width_m: 5.0,
                falloff_m: 9.0,
            )),
            Stroke(StrokeSpec(
                points: [(612.0, 598.0), (632.0, 570.0), (644.0, 538.0), (648.0, 516.0)],
                profile: Ridge(amp_m: 1.6),
                half_width_m: 5.0,
                falloff_m: 9.0,
            )),
            // The bridge causeway (RoadProfile's debut): the approach to the stone bridge
            // rides half a metre over the floodplain it crosses - an earthwork that CANNOT
            // drift from the street it carries, because it has no points of its own.
            RoadProfile(RoadProfileSpec(
                road_id: "bridge_street",
                profile: Ridge(amp_m: 0.5),
                half_width_m: 4.0,
                falloff_m: 7.0,
            )),
            // Teren W2 (audyt "Atlas Terenu", 2026-08-25): the valley was an OPEN BOOK -
            // the exposure sweep read only ~10% of standable ground hidden from the enemy
            // half and a 0.3-1.5% hull-down band, with every metre of the march to the
            // crossings in full view. The masking grammar a floodplain can honestly carry
            // is the LEVEE: deep balkas do not fit here (a 1.7 m cut dives under the
            // 5.0 m water table and trips the puddle contract), but flood-banks RISE.
            // THREE metres, measured and not guessed: the sight rule forgives a 0.3 m
            // graze and the turret top rides at 2.53, so a bank under ~2.9 m is nearly
            // transparent to spotting at range - the first cut of this sculpt laid 1.7 m
            // levees and the exposure sweep did not move a tenth of a point. A 3 m bank
            // hides the whole silhouette; crossing it anywhere is a slow 0.56-grade climb
            // (deliberate - the road gate is the fast gap), and the FIGHTING crests are
            // the census-band lips below, not the levee itself.
            //
            // The west levee pair: a flood-bank between the valley road and the ford
            // track, the masked walk toward the south/north fords. The valley road
            // breaches it at its own crossing - the gap in the mask is the road gate,
            // exposed by design.
            Stroke(StrokeSpec(
                points: [(438.0, 318.0), (472.0, 326.0), (500.0, 330.0)],
                profile: Ridge(amp_m: 3.0),
                half_width_m: 4.0,
                falloff_m: 10.0,
            )),
            Stroke(StrokeSpec(
                points: [(438.0, 682.0), (472.0, 674.0), (500.0, 670.0)],
                profile: Ridge(amp_m: 3.0),
                half_width_m: 4.0,
                falloff_m: 10.0,
            )),
            // The east levee pair: the mill-side flood-bank screening the run from the
            // orchards toward the plank crossings.
            Stroke(StrokeSpec(
                points: [(612.0, 238.0), (640.0, 262.0), (664.0, 286.0)],
                profile: Ridge(amp_m: 3.0),
                half_width_m: 4.0,
                falloff_m: 10.0,
            )),
            Stroke(StrokeSpec(
                points: [(612.0, 762.0), (640.0, 738.0), (664.0, 714.0)],
                profile: Ridge(amp_m: 3.0),
                half_width_m: 4.0,
                falloff_m: 10.0,
            )),
            // The east-bank lips: a crest-and-shelf pair on the floodplain shoulder above
            // the town approach, looking WEST over the bridge and fords - the far bank
            // finally answers Windmill Hill with hull-down of its own instead of an open
            // slope. Windows sit off the axis so the bridge street keeps its grade.
            CrestShelf(
                crest_x: 655.0,
                shelf_x: 672.0,
                sigma_x: 8.0,
                crest_h: 1.6,
                shelf_cut: 1.0,
                windows: [(380.0, 55.0), (620.0, 55.0)],
            ),
            ClampMin(0.2),
        ],
    ),
    water: Some(WaterSpec(
        surface_level_m: 5.0,
    )),
    materials: Some(GroundMaterialsSpec(
        // Damper greens, darker river-worn earth, and grey field stone in place of chalk.
        layers: (
            GroundLayerSpec(albedo: (0.26, 0.33, 0.21), detail: 1.0, gloss: 0.03),
            GroundLayerSpec(albedo: (0.41, 0.38, 0.26), detail: 1.0, gloss: 0.03),
            GroundLayerSpec(albedo: (0.3, 0.26, 0.2), detail: 0.8, gloss: 0.06),
            GroundLayerSpec(albedo: (0.42, 0.4, 0.36), detail: 0.9, gloss: 0.14),
        ),
        macro_normal_strength: 0.65,
        // Valley meadows patch more softly than the steppe's worked plots.
        field_patch_strength: 0.75,
    )),
    environment: Some(EnvironmentSpec(
        // First look = the default and the fallback; list order feeds the seeded roll.
        looks: [
            LookSpec(
                variant: ClearAfternoon,
                preset: ClearAfternoon,
                sky_rgb: (0.62, 0.66, 0.72),
            ),
            LookSpec(
                variant: RainSqualls,
                preset: RainSqualls,
                sky_rgb: (0.42, 0.46, 0.5),
                rain_intensity: 1.0,
                wetness: 1.0,
            ),
            LookSpec(
                variant: DawnFog,
                preset: DawnFog,
                sky_rgb: (0.66, 0.64, 0.64),
                wetness: 0.2,
            ),
        ],
    )),
    objects: [
