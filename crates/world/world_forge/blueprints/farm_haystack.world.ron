// A Bystra farmyard haystack: the drum body under a boxy cap — reads at 300 m, burns in B3's
// destruction forms later. Object-local meters, +Y up, origin on the ground.
(
    name: "farm_haystack",
    kind: Flora,
    parts: [
        (
            name: "stack_body",
            material: Straw,
            shape: Drum(center: (0.0, 1.1, 0.0), radius: 1.6, half_height: 1.1, segments: 10),
        ),
        (
            name: "stack_cap",
            material: Straw,
            shape: Box(center: (0.0, 2.45, 0.0), half: (1.1, 0.35, 1.1)),
        ),
    ],
)
