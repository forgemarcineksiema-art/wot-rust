// Centurion Mk 3 — the part classes the dossier lists (docs/vehicles/centurion.md, § Part list,
// researched 2026-09-06), one row per class with the fact that names it. Since 2026-09-06 the
// part library builds the vehicle whole from `centurion_mk3.visual.ron` (the last of the fleet);
// the rows still owed are debt. Nothing the dossier does not name is listed.
(
    vehicle: "centurion_mk3",
    dossier: Complete,
    locked: false,
    expected: [
        (class: HullTub, source: "Part list: the lower tub, floor 17 mm throughout production"),
        (class: UpperHull, source: "Part list: one 76 mm wedge glacis inset between the tracks, straight top and bottom edges"),
        (class: SternPlate, source: "Part list: the rear plate with the twin mufflers' outlets"),
        (class: TurretShell, source: "Part list: the cast body with the roof welded in"),
        (class: TurretRing, source: "Part list: the 74 in race, electric traverse"),
        (class: TurretStowage, source: "Part list: the bustle stowage bin"),
        (class: Cupola, source: "Part list: the commander's cupola, manual 360 deg, split hatches, a periscopic sight and seven periscopes", side: Some(Starboard)), // the British layout: commander and gunner RIGHT of the 20-pounder, loader LEFT — built PORT until K13, 2026-09-06
        (class: Hatches, source: "Part list: the loader's twin covers with a periscope; the driver's split hatch front-right", side: Some(Centre)), // the loader's hatch LEFT, the driver's split hatch front-RIGHT
        (class: Mantlet, source: "Part list: the cast external mantlet, 152 mm at its thickest"),
        (class: GunBarrel, source: "Part list: the 20-pdr Type A, L/66.7, a 5.75 m clean tube - no brake, no fume extractor"),
        (class: CoaxMachineGun, source: "Part list: the 7.92 mm Besa"),
        (class: Periscopes, source: "Part list: the gunner's periscopic sight; the driver's and loader's periscopes"),
        (class: EngineDeck, source: "Part list: the Meteor's deck, rear"),
        (class: DeckGrille, source: "Part list: the louvred intake and outlet grilles on the deck"),
        (class: Exhaust, source: "Part list: twin mufflers, one each side of the rear deck"),
        (class: Fenders, source: "Part list: the long fenders running the hull's length"),
        (class: FenderStowage, source: "Part list: the fender boxes, side-loading from late 1950"),
        (class: Headlights, source: "Part list: the headlights on the fender line", side: Some(Port)), // the lamp on the port front fender box (F4)
        (class: Skirts, source: "Part list: full-length side plates hinged for track access, the tops covered by the removable HEAT skirts"),
        (class: TowHooks, source: "Part list: tow hooks at the edge of the glacis"),
        (class: SuspensionHardware, source: "Part list: three Horstmann bogies a side, nested coil springs; the return rollers"),
        (class: SpareTracks, source: "Part list: manganese-steel links carried as spares"),
    ],
)
