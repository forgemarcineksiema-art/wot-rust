            target: 2.15,
            tolerance: 0.03,
            note: "Hull plan reads long and wide — a heavy, but lower-slung than the Germans.",
        ),
        RatioTarget(
            kind: HullHeightToLength,
            target: 0.239,
            tolerance: 0.02,
            note: "The LOW heavy: hull roof at 1.62 m on a 6.77 m hull.",
        ),
        RatioTarget(
            kind: TurretWidthToHullWidth,
            target: 0.73,
            tolerance: 0.03,
            note: "The wide dome overhangs its ring, most of the hull\'s width.",
        ),
        RatioTarget(
            kind: TurretHeightToHullHeight,
            target: 0.48,
            tolerance: 0.2,
            note: "A flattened frying-pan dome, not a tall casting.",
        ),
        RatioTarget(
            kind: GunProtrusionToHullLength,
            target: 0.45,
            tolerance: 0.03,
            note: "The 122 mm D-25T overhangs almost half the hull again.",
        ),
    ],
