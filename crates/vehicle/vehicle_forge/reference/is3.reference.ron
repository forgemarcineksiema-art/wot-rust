ReferencePack(
    family_slug: "is3",
    display_name: "IS-3",
    vehicles: [
        IS3,
    ],
    summary: "Armored Vehicle Forge reference for the IS-3: the pike-nose heavy — two swept bow plates meeting at a central ridge, a wide flattened cast dome overhanging its ring, six small road wheels per side, and the braked 122 mm D-25T.",
    road_wheel_count_per_side: 6,
    sources: [
        ReferenceSource(
            label: "Wikimedia Commons gallery",
            url: "https://commons.wikimedia.org/wiki/Category:IS-3",
            note: "Photo reference for the pike bow, the flattened dome, and the running gear.",
        ),
        ReferenceSource(
            label: "Tank AFV reference article",
            url: "https://tank-afv.com/coldwar/USSR/IS-3M.php",
            note: "Technical and visual reference for dimensions, armament, and family cues.",
        ),
        ReferenceSource(
            label: "In-repo vehicle notes",
            url: "docs/vehicles/is-3.md",
            note: "Gameplay translation and source summary.",
        ),
    ],
    ratios: [
