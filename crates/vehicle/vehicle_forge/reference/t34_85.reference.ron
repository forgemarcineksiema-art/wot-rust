                url: "docs/vehicles/t-34-85.md",
                note: "6100 mm over the tracks (ru.wikipedia; ligastrelkov); 8.10 - 6.10 = the ZiS-S-53's 2.00 m overhang.",
            ),
            status: Locked,
        ),
        DimensionTarget(
            kind: OverallLengthWithGun,
            target_m: 8.1,
            tolerance_m: 0.04,
            source: ReferenceSource(
