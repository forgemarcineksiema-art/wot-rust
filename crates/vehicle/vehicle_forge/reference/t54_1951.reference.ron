ReferencePack(
    family_slug: "t54",
    display_name: "T-54",
    vehicles: [
        T54_1951,
    ],
    summary: "Armored Vehicle Forge benchmark for the canonical T-54-3 obr. 1951: low Soviet medium hull, five-road-wheel running gear without return rollers, rounded cast turret, D-10T gun without bore evacuator, and photo-backed silhouette ratios.",
    road_wheel_count_per_side: 5,
    sources: [
        ReferenceSource(
            label: "Wikimedia Commons T-54/T-55 gallery",
            url: "https://commons.wikimedia.org/wiki/T-54/T-55",
            note: "Photo reference for T-54 silhouette, turret mass, running gear, and stowage.",
        ),
        ReferenceSource(
            label: "Tanks Encyclopedia T-54-1 article",
            url: "https://tanks-encyclopedia.com/coldwar/soviet/t-54-1-1947/",
            note: "Technical and visual baseline for early T-54 hull, turret, and D-10T cues.",
        ),
        ReferenceSource(
            label: "Project T-54 vehicle notes",
            url: "docs/vehicles/t-54.md",
            note: "In-repo gameplay translation and public source summary.",
        ),
    ],
    ratios: [
        RatioTarget(
            kind: HullLengthToWidth,
            target: 1.85,
            tolerance: 0.15,
            note: "Overall hull plan (6.235 / 3.27) should read as a compact Soviet medium, not a long heavy.",
        ),
        RatioTarget(
            kind: HullHeightToLength,
            target: 0.29,
            tolerance: 0.05,
            note: "Low Soviet medium silhouette (roof 1.58 + fittings / length 6.04): long and flat.",
        ),
        RatioTarget(
            kind: TurretWidthToHullWidth,
            target: 0.68,
            tolerance: 0.1,
            note: "The ~2.25 m cast turret is broad on the 3.27 m hull but stays inside the track span.",
        ),
        RatioTarget(
            kind: TurretHeightToHullHeight,
            target: 0.55,
            tolerance: 0.06,
            note: "The 0.82 m casting (ring 1.58 to roof 2.40) rides the LOW 1.58 hull roof.",
        ),
        RatioTarget(
            kind: GunProtrusionToHullLength,
            target: 0.49,
            tolerance: 0.08,
            note: "The D-10T projects 2.73 m past the bow (9.00 m overall) — decisive but not a heavy-tank gun.",
        ),
        RatioTarget(
            kind: TurretLengthToWidth,
            target: 1.05,
            tolerance: 0.06,
            note: "The cast dome plan is a touch LONGER than wide: 2.363 m over 2.25 (S1).",
        ),
        RatioTarget(
            kind: TurretRingPositionOnHull,
            target: 0.51,
            tolerance: 0.04,
            note: "The ring sits amidships — the dome rides the hull centre, not a bow turret.",
        ),
        RatioTarget(
            kind: RoadWheelDiameterToHullLength,
            target: 0.132,
            tolerance: 0.008,
            note: "810 mm spider-web wheels on the 6.235 m hull read heavy on the side view.",
        ),
    ],
