BlueprintFile(
    kind: T54_1951,
    hull: HullShape(
        // 6.235 m over the hull: the working value between Karpenko's 6.27 (obr. 1949) and
        // ru-wiki's 6.20 (T-54A), which is the whole ±70 mm the sources disagree by. The model
        // shipped 6.00 — a third of a metre short, and the reason the barrel read optically long
        // (overhang 2.93 against a documented 2.58-2.73). Register M1.
        half_len: 3.1175,
        // The tub is what FITS between the tracks, and that is arithmetic, not taste: gauge
        // 2.640 less track 0.580 leaves 2.060 m of clear space, so the box is 1.03 each side.
        // It was 1.05 — described in the visual as "the narrow ~2.1 m box" — which is 20 mm
        // wider than the space the documented running gear leaves for it. Register M9.
        half_width: 1.03,
        // Ground clearance 425 mm, four sources agreeing. The bake read 440.
        belly_y: 0.425,
        deck_y: 1.58,
        glacis_slope_deg: 60.0,
        pike_sweep_deg: 0.0,
        nose_rise: 0.06,
        // 45 mm @ 17 deg (ru-wiki armour table + warbook agree). It was 5.0 — typed in the
        // data.rs era with no source, and for months nothing ever fired at the stern to
        // notice. The knuckle and the undercut below it live in `armor.hull_rear_knuckle`.
        rear_slope_deg: 17.0,
        lower_half_width: 1.03,
        sponson_y: 1.0,
        skirt: None,
        hitbox_half_width: 1.75,
        hitbox_half_height: 1.341,
        // The same 0.15 m of margin the box always carried past the hull plates.
        hitbox_half_length: 3.2675,
        hitbox_center_y: 1.19,
        hitbox_turret_min_y: 0.39,
    ),
    track: TrackShape(
        // Track gauge 2.640 m (the distance between the two belts' centrelines), four sources
        // agreeing. It was 2.690. The documented set closes on itself: gauge 2.640 + track
        // 0.580 = 3.220 over the tracks, and 25 mm of fender overhang each side makes the
        // documented 3.270 over the fenders. Register M9.
        center_x: 1.32,
        belt_half_thickness: 0.13,
        top_y: 0.905,
        bottom_y: 0.045,
        wheel_radius: 0.405,
        wheel_count: 5,
        // Ground-contact base 3.840 m: the first road wheel's centre to the last. It was
        // 3.900. The enlarged 1st-to-2nd gap keeps its ratio to the other three (1.24), which
        // is the recognition feature, not the absolute spacing.
        wheel_first_z: -1.92,
        wheel_last_z: 1.92,
        // The belt's centre line wraps at `end_radius + LINK_SEAT`, and the documented
        // engagement circle is the sprocket's 572.4 mm pitch diameter — 0.2862 m of radius.
        // 0.30 put the wrap at 0.32, which is why the tooth count came out 14 (the modernised
        // T-55 / Obj. 167 wheel) where the T-54 has 13. The count is not authored anywhere: it
        // is the number of link pitches around this circle, so fixing the circle fixes it.
        // REAR (sprocket) end. 2.590 is not free to move: the sprocket disc clears the last
        // road wheel's tyre by millimetres already (`no_running_gear_disc_merges_into_another`
        // — pulling it to the three-view's ~2.53 buries 58 mm of disc in the wheel), and the
        // 90 x 137 mm loop identity pins the other side. The sheet's far-out end axles imply
        // a 93-95 link belt and are rejected on that identity, the same way its idler was.
        end_radius: 0.2662,
        end_z: 2.590,
        // FRONT (idler): its own wheel at its own axle — the dossier's ⌀510 cast idler with
        // steel tyres (it was drawn as a second sprocket-sized wheel), stood as far outboard
        // as the loop identity and the sprocket's fixed seat allow (taut pitch 137.3 mm).
        // The wrap's outer tip gains ~20 mm toward the bow; the honest half of the sheet's
        // "idler proud of the bow" read — the other half fails the link-count identity that
        // arbitrates every end-position claim on this vehicle.
        end_front: Some((2.620, 0.255)),
        // Raised so the top run leaves the end wheels ABOVE the 0.88 m wheel tops — links
        // grinding the tyres z-fight. What is authored is that 0.96 m anchor, and it was
        // written as 0.66 against a 0.32 wrap. The wrap is the sprocket's real pitch circle
        // now, so keeping the anchor means moving this number with it: 0.96 − 0.2862. Written
        // as a bare 0.66 the anchor would have dropped 34 mm the moment the wrap was corrected,
        // silently — the middle of the span is governed by the wheels and would not have shown
        // it.
        end_y: 0.674,
        // 580 mm of shoe, on the 2.640 gauge: 1.32 ± 0.29. It was 570 on a 2.690 gauge.
        inner_x: 1.03,
        outer_x: 1.61,
        segments: 14,
        wheel_stations: Some([
            -1.92,
            -1.014,
            -0.108,
            0.798,
            1.92,
        ]),
        return_rollers: 0,
        roller_radius: 0.0,
        overlap_inner_dx: 0.0,
        wheel_half_width: 0.18,
        link_half_width: 0.23,
        link_count: Some(90),
        // NO RETURN ROLLERS, so the top run hangs on the road wheels and scallops between them.
        // That sag is the T-54's side-view signature and every reference photograph shows it
        // deep. The 0.075 it carried was ALSO "raised to the depth the drawings show" — but
        // nobody measured the outcome: the tension formula halved it on the 0.906 m wheel
        // span and the eye got a 33 mm dip against the ~95 mm the calibrated three-view and
        // the DoD rear photo show. Authored for the RESULT now (formula normalises at 1 m,
        // `the_top_run_scallops_to_its_measured_depth` locks the dip itself): 0.12 hangs
        // ~94 mm between wheels and ~118 mm across the enlarged front gap. Vehicles whose top
        // run rides interleaved wheels (the Tiger family, Panther II, Jagdtiger) keep a
        // shallow sag: theirs is supported nearly continuously.
        top_sag_m: 0.12,
        // Twelve radial webs, not six spokes: the obr. 1951 disc is the stamped "spider-web"
        // (12 ribs, 12 small + 12 large lightening holes) — see the part-construction dossier
        // in docs/vehicles/t-54.md. The five-arm starfish is a later/rebuild wheel.
        wheel_spokes: 12,
        wheel_face: SpiderWeb,
    ),
    turret: TurretShape(
        form: CastDome,
        ring_y: 1.58,
        ring_z: 0.0,
        ring_radius: 0.91,
        base_radius: 1.12,
        roof_radius: 0.42,
        roof_y: 2.40,
        front_slope_deg: 35.0,
        side_slope_deg: 25.0,
        rear_slope_deg: 10.0,
        cupola_x: 0.34,
        cupola_z: -0.1,
        // The commander's cupola is 624 mm across the outside (Tankograd). The model carried
        // 480 — a fifth too small on the one fitting that reads at every range, because it is
        // the thing standing above the roofline.
        cupola_radius: 0.312,
        cupola_height: Some(0.131),
        plan_half_width: 1.125,
        plan_half_length: 1.30,
        // The APERTURE, not a ball: the documented opening is ~0.40 m across, so its half-
        // extent is 0.20. This used to be 0.32 (a 0.64 m mask) inflated another 20% by the
        // external-ball patch rule — a gun mount half again wider than the hole it sits in.
        mantlet_radius: 0.20,
        mantlet_back_z: 0.85,
        // Twice the default: this low hemispherical casting IS the T-54's armour argument,
        // so the normal a shell meets must sweep, not step.
        sector_count: 24,
        mantlet_front_z: 1.12,
    ),
    gun: GunShape(
        trunnion_y: 1.78,
        trunnion_z: 1.15,
        // The muzzle sits 2.73 m past the bow — the documented overhang (the dossier's own
        // sanity check: 9.00 m overall minus a 6.27 m hull). It used to be an absolute, so when
        // the hull grew the gun grew with it and the overall length walked past its Locked
        // anchor. 3.1175 + 2.73.
        muzzle_z: 5.8475,
        barrel_radius: 0.092,
        evacuator: None,
        muzzle_brake: None,
        segments: 12,
    ),
    armor: ArmorShape(
        hull_front: (60.0, 1.0),
        hull_side: (0.0, 1.0),
        hull_rear: (17.0, 1.0),
        turret_front: (35.0, 1.0),
        turret_side: (25.0, 1.0),
        turret_rear: (10.0, 1.0),
        turret_side_taper: Some(0.41),
        // 100 mm @ 55 deg (dossier, high confidence). The fleet derivation (glacis x 0.45)
        // made this a 27-degree plate under a 36.8-degree visual - both wrong, each
        // differently. Authored, both read this line.
        hull_lower_front: Some((55.0, 1.0)),
        // The overhung tail: knuckle at 1.20 m (the hull's rearmost line — measured off the
        // calibrated three-view, where it lands on the same stern the muzzle and wheelbase
        // anchors hit to the pixel), undercut ~45 deg below it (drawing-derived, medium
        // confidence — no armour table splits the lower rear out; it hides behind the
        // sprocket either way).
        hull_rear_knuckle: Some((1.20, 45.0)),
        // The course MG port, right of the driver — the same seat the kit draws
        // (t54_kit_lines::course_mg_port at glacis x 0.42, y 1.15, muzzle disc 0.105).
        // Inside the disc the 100 mm plate presents FLAT: the 60-degree rake that doubles
        // the glacis is exactly what the port gives up.
        glacis_ports: (Some(GlacisPort(x: 0.42, y: 1.15, radius_m: 0.11)), None),
    ),
)