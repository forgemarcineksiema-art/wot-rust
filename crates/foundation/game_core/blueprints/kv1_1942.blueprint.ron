// KV-1 model 1942, reinforced cast turret (ChKZ, Jan-Aug 1942). 6.75 m hull, 3.32 m over the
// 700 mm tracks, 2.71 m to the turret roof. The whole tank is one idea and it is the OPPOSITE of
// the T-34's: where the T-34 bet everything on a 60-degree glacis, the KV bet on millimetres --
// a shallow stepped bow, 75 mm sides standing dead vertical, a flat deck, and a 100 mm cast
// turret that is a long slab-sided LOAF, not a dome. Six small 600 mm wheels at an EVEN pitch
// (no Christie gap, no T-54 stagger) on torsion bars, their top run carried TAUT on three return
// rollers, drive sprocket at the tail. The 76 mm ZiS-5 is so short the muzzle barely clears the
// bow: overall length gun-forward is essentially the hull length, the least overhang in the fleet.
// Dossier: docs/vehicles/kv-1.md.
BlueprintFile(
    kind: KV1_1942,
    hull: HullShape(
        half_len: 3.375,
        // The armoured superstructure is NARROWER than the 3.32 m width over tracks: the 75 mm
        // side plate stands at 1.42 and the squared fender shelves bridge outward over the
        // running gear to the track face. Setting this flush with `outer_x` would bury the
        // fenders inside the hull and leave the return rollers unreadable from the flank.
        half_width: 1.42,
        belly_y: 0.43,
        // The TALL Soviet heavy hull: a flat deck at 1.75 leaving 0.96 m of turret above it.
        deck_y: 1.75,
        // The stepped three-plate bow averaged into ONE plate -- see "Known deviations" in the
        // dossier. 52 degrees over the rise puts the deck's front edge where the references show
        // it, and the derived lower plate matches the real near-vertical driver's plate.
        glacis_slope_deg: 52.0,
        pike_sweep_deg: 0.0,
        nose_rise: 0.05,
        rear_slope_deg: 20.0,
        // The 1.92 m tub between the tracks, under a sponson that overhangs the wheel tops.
        lower_half_width: 0.96,
        sponson_y: 0.95,
        skirt: None,
        // 3.32 m over the tracks; top at 1.36 + 1.41 = 2.77 bounds the 2.71 m tank plus hatch rims.
        hitbox_half_width: 1.66,
        hitbox_half_height: 1.41,
        hitbox_half_length: 3.42,
        hitbox_center_y: 1.36,
        hitbox_turret_min_y: 0.39,
    ),
    track: TrackShape(
        center_x: 1.31,
        belt_half_thickness: 0.13,
        // The top run rides HIGH and taut on the rollers, well clear of the wheel tops at 0.63.
        top_y: 0.95,
        bottom_y: 0.03,
        // Six 600 mm discs -- small wheels, the opposite of the T-34's 830 mm Christie plates.
        wheel_radius: 0.30,
        wheel_count: 6,
        wheel_first_z: -2.05,
        wheel_last_z: 2.05,
        end_radius: 0.29,
        end_z: 2.85,
        // Wrap top (end_y + end_radius) = 0.95 = the belt's top line.
        end_y: 0.66,
        inner_x: 0.96,
        outer_x: 1.66,
        segments: 14,
        // EVEN pitch, explicitly: the KV's ground signature. `None` spreads the six stations
        // evenly across the run, which is exactly right here -- and the cage locks it.
        wheel_stations: None,
        return_rollers: 3,
        roller_radius: 0.11,
        overlap_inner_dx: 0.0,
        wheel_half_width: 0.15,
        // The 700 mm band.
        link_half_width: 0.33,
        link_count: Some(88),
        // A rollered run stays taut; sag lives in the long wrap gaps, not over the wheels.
        top_sag_m: 0.012,
        wheel_spokes: 8,
        drive_front: false,
        // The heavy cast shoe, not the T-54 family's small-pitch Omsh.
        shoe_pattern: KvCast,
        wheel_face: Openwork,
        suspension: TorsionBar,
    ),
    turret: TurretShape(
        // A CASTING with flat walls: the armour bakes it as a prism because its plan is a
        // stadium, not a circle. See TurretForm::CastSlab.
        form: CastSlab,
        ring_y: 1.75,
        ring_z: 0.05,
        ring_radius: 0.77,
        base_radius: 0.98,
        // A WIDE FLAT roof, not a dome crown. The casting's roof is at 2.62; the commander's
        // periscope standing on it reaches the documented 2.71 m OVERALL height.
        roof_radius: 0.85,
        roof_y: 2.62,
        // Near-vertical walls: 6 degrees of side slope over 0.96 m of rise pulls the roof in by
        // only 0.10 m, so the crown keeps ~90% of the shoulder beam. A dome does not do this.
        front_slope_deg: 14.0,
        side_slope_deg: 6.0,
        rear_slope_deg: 8.0,
        // Flush roof hatches at the REAR of the long casting -- no commander's drum cupola;
        // that arrived with the KV-1S, which this vehicle deliberately is not.
        cupola_x: -0.30,
        cupola_z: -0.62,
        cupola_radius: 0.26,
        // 2.64 long x 1.96 wide: a loaf, L/W 1.35 -- the highest turret plan ratio in the fleet.
        plan_half_width: 0.98,
        plan_half_length: 1.32,
        mantlet_radius: 0.24,
        mantlet_back_z: 1.06,
        mantlet_front_z: 1.34,
    ),
    gun: GunShape(
        // Fire line 2.05, trunnion seated just behind the mantlet face like the rest of the fleet.
        trunnion_y: 2.05,
        trunnion_z: 1.28,
        // 0.45 m past the 3.375 bow. The real ZiS-5 barely reaches the nose -- sources quote the
        // KV's overall length as its hull length -- but two engine invariants force some
        // overhang: the barrel must clear the hitbox (`all_vehicles`) and the mount frame needs
        // 2.5 m of tube ahead of the trunnion (`mount.rs`). A recorded deviation; even so this is
        // the least overhang in the fleet by a factor of five, which is the identity that matters.
        muzzle_z: 3.82,
        barrel_radius: 0.062,
        // The ZiS-5 is a CLEAN tube: no brake, no fume extractor.
        evacuator: None,
        muzzle_brake: None,
        segments: 12,
    ),
    armor: ArmorShape(
        // Mass without slope. The bow is shallow, the sides are DEAD VERTICAL 75 mm, and the
        // cast turret barely leans at all -- this tank does not bounce shells, it stops them.
        hull_front: (52.0, 0.92),
        hull_side: (0.0, 1.0),
        hull_rear: (20.0, 1.0),
        turret_front: (14.0, 0.90),
        turret_side: (6.0, 1.0),
        turret_rear: (8.0, 1.0),
    ),
)
