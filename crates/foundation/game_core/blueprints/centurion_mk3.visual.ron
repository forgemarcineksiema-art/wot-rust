// Centurion Mk 3 (1948-52, the 20-pdr Type A, the Besa coax) — authored visual parts (Forge 2.0
// K3, 2026-09-06, the last vehicle of the fleet to leave its recipe). The part library builds
// every class from this file and the blueprint: the welded hull on the armour planes (the 57°
// glacis wedge, vertical sides), the bazooka plates on the spaced plane, the cast Mk 3 dome with
// the British cupola and the bustle bin, the clean 20-pounder, the British deck — the engine
// panel and grille, the exhaust cowls, the driver's rectangular hatch on the roof right, the
// fender boxes — and the fittings. The bake frame: +Y up, +Z bow, +X port. Dossier:
// docs/vehicles/centurion.md.
VisualDetailFile(
    kind: Centurion,
    detail: VisualDetail(
        // The 84 mm Ordnance QF 20-pounder Type A: bore 84 mm -> bore_radius 0.042; tube radius
        // 0.095 = the gameplay gun's; a CLEAN tube — no brake, no fume extractor (every source).
        // The cast external mantlet spans the armour's patch band 1.02 .. 1.32 (trunnion_z 1.30
        // -> trunnion-relative -0.28 .. +0.02), widest 0.30 = the gameplay mantlet_radius.
        gun: Some(GunVisual(
            barrel_radius: 0.095,
            muzzle_radius: 0.07,
            bore_radius: 0.042,
            muzzle_taper: 0.15,
            barrel_segments: 12,
            mantlet_profile: (
                (-0.28, 0.0),
                (-0.26, 0.22),
                (-0.20, 0.28),
                (-0.13, 0.30),
                (-0.05, 0.30),
                (0.0, 0.26),
                (0.015, 0.14),
                (0.02, 0.0),
            ),
            mantlet_segments: 12,
            mantlet_scale: (1.0, 1.0, 1.0),
            muzzle_brake: None,
            module_delta_scale: 0.65,
        )),
        // Welded plate on the armour planes: the tub, the upper box with vertical sides
        // (`hull_side 0`), the 57° glacis (its angle unsourced — see the dossier).
        construction: Some(WeldedSlab),
        // The cast Mk 3 dome: the family's loft over the ring and roof, the wide British cupola
        // with its sight hoods and the loader's flush hatch, the broad socket, and the bustle
        // stowage bin closing the rear of the plan (the recipe's 0.44 rise, 0.16 inset, 1.50 x
        // 0.44 x 0.30 box).
        cast_dome: Some(CastDomeVisual(
            segments: 20,
            roof: Centurion,
            ring_height: 0.12,
            ring_segments: 16,
            socket_segments: 12,
            bustle_bin: Some(BustleBinVisual(
                rise: 0.44,
                back_inset: 0.16,
                half: (0.75, 0.22, 0.15),
            )),
        )),
        // The British deck: the flat raised panel with its mesh-grille frame, the low armoured
        // exhaust cowls on the rear flanks, the driver's rectangular split hatch on the roof
        // RIGHT (0.40 behind the deck's front edge), and the fender boxes over the belts.
        british_deck: Some(BritishDeckVisual(
            exhaust_cowls: true,
            driver_roof_hatch: Some((-0.4275, 0.40, 0.26, 0.28)),
            fender_boxes: Some((0.12, 0.35)),
        )),
        fittings: Some(FittingsVisual(
            // The cupola's lid and the loader's hatch are the dome's own; the driver's hatch is
            // the deck's rectangular one: none of the three round lids below is built.
            cupola_hatch_center: (-0.40, 2.97, -0.55),
            cupola_hatch_radius: 0.30,
            cupola_hatch_half_height: 0.03,
            driver_hatch_center: (-0.4275, 1.88, 2.06),
            driver_hatch_radius: 0.27,
            driver_hatch_half_height: 0.03,
            loader_hatch_center: (0.34, 2.74, -0.25),
            loader_hatch_radius: 0.20,
            loader_hatch_half_height: 0.03,
            no_cupola_hatch: true,
            no_loader_hatch: true,
            no_driver_hatch: true,
            // The headlight stands on the port front fender box (F4: absent until the boxes
            // existed — they do now): the box tops out 0.27 over the sponson line at the belt's
            // centre (x 1.275), the lamp's drum on it.
            headlight_center: (1.275, 1.295, 2.80),
            headlight_radius: 0.075,
            headlight_half_height: 0.09,
            // The tow hooks at the edge of the glacis.
            tow_hook_center: (0.589, 1.05, 3.64),
            tow_hook_half: (0.10, 0.08, 0.12),
            second_bow_hatch_center: None,
        )),
    ),
)
