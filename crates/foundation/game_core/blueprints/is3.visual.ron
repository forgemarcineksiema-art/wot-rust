// IS-3 (1945 production, Object 703) — authored visual parts (Forge 2.0 K3, 2026-09-06, the sixth
// vehicle the library builds whole). The part library builds every class from this file and the
// blueprint: the welded PIKE hull on the armour planes (two 110 mm bow plates at 56°, swept ±38°,
// meeting at the ridge), the flattened cast dome with NO cupola — two flush hatches and the
// commander's periscope on its roof — the D-25T with its brake, the Soviet deck with the IS
// family's fender line and its fuel drums, and the fittings. The bake frame: +Y up, +Z bow, +X
// port. Dossier: docs/vehicles/is-3.md.
VisualDetailFile(
    kind: IS3,
    detail: VisualDetail(
        // The 122 mm D-25T: bore 122 mm -> bore_radius 0.061; tube radius 0.105 = the gameplay
        // gun's; the double-baffle brake, no evacuator. The cast mantlet spans the armour's patch
        // band 0.95 .. 1.25 (trunnion_z 1.05 -> trunnion-relative -0.10 .. +0.20), widest 0.35 =
        // the gameplay mantlet_radius, round.
        gun: Some(GunVisual(
            barrel_radius: 0.105,
            muzzle_radius: 0.08,
            bore_radius: 0.061,
            muzzle_taper: 0.15,
            barrel_segments: 12,
            mantlet_profile: (
                (-0.10, 0.0),
                (-0.08, 0.26),
                (-0.02, 0.33),
                (0.05, 0.35),
                (0.12, 0.34),
                (0.17, 0.28),
                (0.195, 0.15),
                (0.20, 0.0),
            ),
            mantlet_segments: 12,
            mantlet_scale: (1.0, 1.0, 1.0),
            muzzle_brake: Some(MuzzleBrakeVisual(
                radius: 0.155,
                length: 0.40,
                baffles: 2,
            )),
            module_delta_scale: 0.65,
        )),
        // The pike hull: the tub, the upper box, and the four pike faces on the SAME plane
        // equations the armour bakes (the fold ridge at the sponson step, the 56° slope, the
        // ±38° sweep).
        construction: Some(WeldedPike),
        // The flattened casting: the family's dome loft over the blueprint's ring and roof; the
        // roof carries NO cupola — two flush hatches at the cupola stations (mirrored) and the
        // commander's periscope ahead of the port one; the broad mantlet socket; no bin.
        cast_dome: Some(CastDomeVisual(
            segments: 20,
            roof: Is3,
            ring_height: 0.12,
            ring_segments: 16,
            socket_segments: 12,
            bustle_bin: None,
        )),
        // The Soviet deck the IS-3 wears: four louvres over the bay, the V-2's exhaust ports
        // 0.35 under the deck line on the 18° stern, no glacis furniture (the pike carries the
        // driver's hatch in the ROOF behind its apex — a fitting), the IS family's fender line
        // — the shelf, the front mudguard sloping over the idler, the rear flap — and the two
        // external fuel drums lying along the rear shelves.
        soviet_deck: Some(SovietDeckVisual(
            louvres: 4,
            exhaust_port_y: 1.27,
            glacis_hatch: None,
            glacis_mg_ball: None,
            is_fenders: true,
            fuel_drums: true,
        )),
        fittings: Some(FittingsVisual(
            // No cupola (the flush hatches and the periscope are the dome's own parts): the
            // stations below are documentation, not built.
            cupola_hatch_center: (0.35, 2.44, -0.35),
            cupola_hatch_radius: 0.27,
            cupola_hatch_half_height: 0.03,
            loader_hatch_center: (-0.35, 2.44, -0.35),
            loader_hatch_radius: 0.27,
            loader_hatch_half_height: 0.03,
            no_cupola_hatch: true,
            no_loader_hatch: true,
            // The driver's compact round hatch on the hull roof, centred just behind the pike
            // apex (the free roof band is narrow: the pike planes slice the deck's corners and the
            // turret plan reaches far forward).
            driver_hatch_center: (0.0, 1.65, 1.45),
            driver_hatch_radius: 0.19,
            driver_hatch_half_height: 0.05,
            // The headlight on the roof's left, behind the pike's edge (at x 0.30 the roof
            // begins at z 1.86).
            headlight_center: (0.30, 1.71, 1.72),
            headlight_radius: 0.085,
            headlight_half_height: 0.10,
            // The pike carries no bow hooks: the tow hooks are at the STERN corners.
            tow_hook_center: (0.57, 1.00, -3.31),
            tow_hook_half: (0.10, 0.08, 0.12),
            second_bow_hatch_center: None,
        )),
    ),
)
