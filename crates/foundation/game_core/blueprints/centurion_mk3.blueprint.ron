BlueprintFile(
    kind: Centurion,
    hull: HullShape(
        // 7557 mm hull (24 ft 9.5 in, the 1965 User Handbook via en.wikipedia; Discovery UK 7.55) — K3 data, 2026-09-06.
        half_len: 3.7785,
        half_width: 1.6,
        belly_y: 0.51,
        deck_y: 1.88,
        glacis_slope_deg: 57.0,
        pike_sweep_deg: 0.0,
        nose_rise: 0.05,
        rear_slope_deg: 8.0,
        lower_half_width: 0.95,
        sponson_y: 0.95,
        skirt: Some(SkirtShape(
            top_y: 0.98,
            bottom_y: 0.33,
            front_z: 2.9,
            rear_z: -2.9,
            // The side plates stand 3.38 m wide (11 ft 1 in, the Handbook and the placard): 0.10 off the belt.
            standoff_m: 0.10,
            thickness_m: 0.008,
        )),
        hitbox_half_width: 1.7,
        hitbox_half_height: 1.52,
        hitbox_half_length: 3.86,
        hitbox_center_y: 1.47,
        hitbox_turret_min_y: 0.41,
    ),
    track: TrackShape(
        center_x: 1.275,
        belt_half_thickness: 0.13,
        top_y: 0.86,
        bottom_y: 0.03,
        // The three return rollers carry the top run at 0.86, well above the wheel tops — so the
        // axle line is authored, not averaged out of the belt (0.03 + 0.305 + the link seat puts
        // the ground run back on the belt bottom).
        axle_y: Some(0.355),
        wheel_radius: 0.305,
        wheel_count: 6,
        wheel_first_z: -2.05,
        wheel_last_z: 2.05,
        end_radius: 0.28,
        end_z: 2.75,
        end_y: 0.58,
        inner_x: 0.97,
        outer_x: 1.58,
        segments: 14,
        // Three Horstmann bogies: the two wheels of a bogie run 0.66 apart — 0.05 of daylight
        // between ⌀0.61 tyres, as close as they can stand without merging — and 1.06 separates
        // one bogie from the next.
        wheel_stations: Some([
            -2.05,
            -1.39,
            -0.33,
            0.33,
            1.39,
            2.05,
        ]),
        return_rollers: 3,
        roller_radius: 0.1,
        overlap_inner_dx: 0.0,
        wheel_half_width: 0.12,
        link_half_width: 0.24,
        link_count: Some(102), // the Mk 3 double-pin track
        top_sag_m: 0.035,
        wheel_spokes: 6,
        shoe_pattern: BritishCast,
        wheel_face: RubberDish,
        suspension: Horstmann,
    ),
    turret: TurretShape(
        form: CastDome,
        ring_y: 1.88,
        ring_z: -0.15,
        ring_radius: 0.94,
        base_radius: 1.05,
        roof_radius: 0.4,
        roof_y: 2.78,
        front_slope_deg: 40.0,
        side_slope_deg: 30.0,
        rear_slope_deg: 15.0,
        // RIGHT of the gun: the British layout seats the commander and gunner starboard, the
        // loader port. Built at +0.4 (port) until K13's fleet handedness walk, 2026-09-06.
        cupola_x: -0.4,
        cupola_z: -0.55,
        cupola_radius: 0.33,
        plan_half_width: 1.1,
        plan_half_length: 1.45,
        mantlet_radius: 0.3,
        mantlet_back_z: 1.02,
        mantlet_front_z: 1.32,
    ),
    gun: GunShape(
        trunnion_y: 2.16,
        trunnion_z: 1.3,
        // 9830 mm overall gun forward (the Handbook; a museum placard's 32 ft 4 in) over the 7.557 hull.
        muzzle_z: 6.0515,
        barrel_radius: 0.095,
        evacuator: None,
        muzzle_brake: None,
        segments: 12,
    ),
    armor: ArmorShape(
        hull_front: (57.0, 1.0),
        hull_side: (0.0, 1.0),
        hull_rear: (8.0, 1.0),
        turret_front: (40.0, 1.0),
        turret_side: (30.0, 1.0),
        turret_rear: (15.0, 1.0),
        turret_side_taper: None,
    ),
)
