// Tiger I Ausf. E — authored visual parts (W4 F5.iii: the first non-benchmark vehicle in the
// fleet slot). Only the GUN GROUP is authored; every other part is None, and the recipe keeps
// covering the rest — a partial block improves the look without claiming cut-truth.
//
// The 8.8 cm KwK 36 L/56 (dossier: docs/vehicles/panzerkampfwagen-vi-tiger.md):
//   bore 88 mm -> bore_radius 0.044; tube radius 0.1 = the gameplay gun's, one truth;
//   double-baffle muzzle brake, NO bore evacuator, NO canvas (external mantlet - no window).
// The Walzenblende: a wide rolled casting spanning exactly the armour's mantlet patch band
// (mantlet_back_z 1.30 .. front_z 1.60 since the STT 1944 sheet re-sourced the turret — the
// front plate stands at ring_z + plan_half_length = 1.30; trunnion_z 1.28 -> trunnion-relative
// +0.02 .. +0.32; widest 0.34 = the gameplay mantlet_radius) - the visible body IS the volume
// the armour quotes.
VisualDetailFile(
    kind: TigerI,
    detail: VisualDetail(
        gun: Some(GunVisual(
            barrel_radius: 0.1,
            muzzle_radius: 0.058,
            bore_radius: 0.044,
            muzzle_taper: 0.2,
            barrel_segments: 12,
            mantlet_profile: (
                (0.02, 0.0),
                (0.04, 0.28),
                (0.10, 0.33),
                (0.17, 0.34),
                (0.25, 0.335),
                (0.30, 0.3),
                (0.318, 0.18),
                (0.32, 0.0),
            ),
            mantlet_segments: 12,
            mantlet_scale: (1.35, 0.85, 1.0),
            muzzle_brake: Some(MuzzleBrakeVisual(
                radius: 0.15,
                length: 0.34,
                baffles: 2,
            )),
            module_delta_scale: 0.65,
        )),
        // The fittings, read off the STT 1944 sheet (docs/vehicles/panzerkampfwagen-vi-tiger.md
        // § Reference drawings; Forge 2.0 K3, the first library parts on this vehicle). The part
        // library builds them (`vehicle_build::fitting_parts_for_blueprint`) and the recipe's deck
        // leaves its own hatches, lamp and hooks out. The bake frame: +Y up, +Z bow, +X port.
        fittings: Some(FittingsVisual(
            // The commander's lid on the cupola top (roof 2.55 + 0.40 proud), port, rear.
            cupola_hatch_center: (0.50, 2.97, -0.35),
            cupola_hatch_radius: 0.30,
            cupola_hatch_half_height: 0.04,
            // The two bow hatches on the hull roof (plan: +-0.87 m off the centreline at
            // z +1.69): the driver's, port, and the radio operator's, starboard.
            driver_hatch_center: (0.87, 1.808, 1.69),
            driver_hatch_radius: 0.26,
            driver_hatch_half_height: 0.05,
            // The loader's hatch on the turret roof, starboard, forward (plan). Rooted into the
            // flat roof so the lid stands 3.5 cm proud: the bare-roof anchor (2.55 +-0.06) must
            // find the roof, not the lid.
            loader_hatch_center: (-0.96, 2.545, 0.98),
            loader_hatch_radius: 0.24,
            loader_hatch_half_height: 0.04,
            // The single headlight on the driver's plate, starboard (front view: x -0.52, y 1.59,
            // r 0.17); the plate stands at z ~2.99 there.
            headlight_center: (-0.52, 1.59, 3.00),
            headlight_radius: 0.17,
            headlight_half_height: 0.10,
            // The bow shackles at the nose corners (front view: x +-0.88, y ~0.90).
            tow_hook_center: (0.88, 0.90, 3.05),
            tow_hook_half: (0.10, 0.08, 0.12),
            second_bow_hatch_center: Some((-0.87, 1.808, 1.69)),
        )),
    ),
)
