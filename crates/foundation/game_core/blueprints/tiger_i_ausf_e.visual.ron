// Tiger I Ausf. E — authored visual parts (W4 F5.iii: the first non-benchmark vehicle in the
// fleet slot). Only the GUN GROUP is authored; every other part is None, and the recipe keeps
// covering the rest — a partial block improves the look without claiming cut-truth.
//
// The 8.8 cm KwK 36 L/56 (dossier: docs/vehicles/panzerkampfwagen-vi-tiger.md):
//   bore 88 mm -> bore_radius 0.044; tube radius 0.1 = the gameplay gun's, one truth;
//   double-baffle muzzle brake, NO bore evacuator, NO canvas (external mantlet - no window).
// The Walzenblende: a wide rolled casting spanning exactly the armour's mantlet patch band
// (mantlet_back_z 1.30 .. front_z 1.60 since the STT 1944 sheet re-sourced the turret — the
// front plate stands at ring_z + plan_half_length = 1.30; trunnion_z 1.28 -> trunnion-relative
// +0.02 .. +0.32; widest 0.34 = the gameplay mantlet_radius) - the visible body IS the volume
// the armour quotes.
VisualDetailFile(
    kind: TigerI,
    detail: VisualDetail(
        gun: Some(GunVisual(
            barrel_radius: 0.1,
            muzzle_radius: 0.058,
            bore_radius: 0.044,
            muzzle_taper: 0.2,
            barrel_segments: 12,
            mantlet_profile: (
                (0.02, 0.0),
                (0.04, 0.28),
                (0.10, 0.33),
                (0.17, 0.34),
                (0.25, 0.335),
                (0.30, 0.3),
                (0.318, 0.18),
                (0.32, 0.0),
            ),
            mantlet_segments: 12,
            mantlet_scale: (1.35, 0.85, 1.0),
            muzzle_brake: Some(MuzzleBrakeVisual(
                radius: 0.15,
                length: 0.34,
                baffles: 2,
            )),
            module_delta_scale: 0.65,
        )),
    ),
)
